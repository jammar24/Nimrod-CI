# Nebius Token Factory Configuration
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA Nemotron Models
# Run 'node scripts/list-models.mjs' to list and verify IDs available in your Nebius account
NEBIUS_MODEL_PRIMARY=nvidia/nemotron-3-super-120b-a12b
NEBIUS_MODEL_FAST=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Tavily Search API (for runtime CVE/CWE reference enrichment)
TAVILY_API_KEY=

# Application Limits & Budget Protection
MAX_DIFF_CHARS=20000
MAX_VERIFY_ITERATIONS=2
DAILY_REQUEST_CAP=300

# Persistent Rate Limiting & Daily Cap (Upstash Redis or Vercel KV)
# Optional in local development (falls back to in-memory window), recommended for Vercel production
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Alternative Vercel KV aliases (auto-detected if present):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
